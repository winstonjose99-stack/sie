{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "index.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "visual/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/visual/(.*)\\.(png|jpg|jpeg|gif|html)",
      "dest": "/visual/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

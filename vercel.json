{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/_router.php?__route=index.php"
    },
    {
      "source": "/index.php",
      "destination": "/api/_router.php?__route=index.php"
    },
    {
      "source": "/visual/(.*)\\.php",
      "destination": "/api/_router.php?__route=visual/$1.php"
    }
  ]
}

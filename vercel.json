{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/visual/(.*)\\.(png|jpg|jpeg|gif|svg|ico|html)",
      "dest": "/visual/$1.$2"
    },
    {
      "src": "/api/(.+)\\.php",
      "dest": "/api/$1.php"
    },
    {
      "src": "/visual/(.+)\\.php",
      "dest": "/api/index.php?__route=visual/$1.php"
    },
    {
      "src": "/(index\\.php)?$",
      "dest": "/api/index.php?__route=index.php"
    }
  ]
}
